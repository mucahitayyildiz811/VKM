<UserControl x:Class="VKM.App.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BrBg}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="HdrBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst bar -->
        <Border Grid.Row="0" Background="{DynamicResource BrHead}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource BrText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: bölümler + klasör ağacı -->
            <Border Grid.Column="0" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="BÖLÜMLER" Foreground="{DynamicResource BrDim}" FontSize="11" FontWeight="SemiBold" Margin="16,16,16,8"/>
                    <ListBox Grid.Row="1" x:Name="PartList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrText}"
                             SelectionChanged="PartList_SelectionChanged"
                             PreviewMouseRightButtonDown="FileList_RightDown" Margin="8,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🗺 Haritayı göster (full sektör)" Click="ShowCaseMap_Click"/>
                                <MenuItem Header="Hex / Sektör (ayrıntı)" Click="Map_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource BrText2}" FontSize="12.5" TextWrapping="Wrap" Margin="4,6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="KLASÖRLER" Foreground="{DynamicResource BrDim}" FontSize="11" FontWeight="SemiBold" Margin="16,10,16,6"/>
                    <TreeView Grid.Row="3" x:Name="FolderTree" Background="Transparent" BorderThickness="0"
                              Margin="6,0,6,8" Foreground="{DynamicResource BrText}"
                              SelectedItemChanged="Tree_SelectedChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <EventSetter Event="Expanded" Handler="Tree_Expanded"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Image Source="{Binding IconImage}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrText2}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource BrAccentText}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Sağ: dosya listesi -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Araç çubuğu: ANA İŞLEMLER her zaman görünür. Dar olursa alt satıra kayar, asla üst üste binmez. -->
                <Grid Grid.Row="0" Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="UpButton" Content="↑ Üst klasör" Click="Up_Click" Visibility="Collapsed"
                                Height="32" Padding="11,0" Margin="0,0,8,6" Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}"
                                BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>

                        <!-- Tek ana işlem: Video Tara. (Diğer taramalar gizli; kod duruyor, sonra gerekirse açılır.) -->
                        <Button x:Name="ScanButton" Content="🗑 Silinmişleri Tara" Click="Scan_Click" Visibility="Collapsed"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrBadBg}" Foreground="{DynamicResource BrBad}"
                                BorderBrush="{DynamicResource BrBadBg}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                        <Button x:Name="CarveButton" Content="🧩 İmza Tara" Click="Carve_Click" Visibility="Collapsed"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrPurpleBg}" Foreground="{DynamicResource BrPurple}"
                                BorderBrush="{DynamicResource BrPurpleBg}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                        <Button x:Name="FindToggle" Content="🔍 Ara" Click="ShowFilter_Click" Visibility="Collapsed"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText2}"
                                BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>

                        <Button x:Name="VideoButton" Content="🎬 Video Tara" Click="Video_Click"
                                Height="32" Padding="14,0" Margin="0,0,8,6" Background="{DynamicResource BrOkBg}" Foreground="{DynamicResource BrAccentText}"
                                BorderBrush="{DynamicResource BrSelBg}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"
                                ToolTip="Video kurtarma: H.264 + H.265 + MJPEG akışını içeriğinden bulur (FS/uzantı/marka fark etmez)"/>
                        <Button x:Name="MapButton" Content="Hex / Sektör" Click="Map_Click"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrAccentText}"
                                BorderBrush="{DynamicResource BrSelBg}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Disk/sektör içeriğini hex olarak incele"/>
                        <Button x:Name="DumpButton" Content="İmza Dök" Click="DumpSignature_Click"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrWarn}"
                                BorderBrush="{DynamicResource BrWarnBg}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Yeni DVR markası tanıtmak için: diskin ilk 4 MB'ını .bin olarak dök (master blok + indeks + ilk kareler)"/>

                        <Button x:Name="CalibButton" Content="🔬 Format Dökümü (oto)" Click="CalibDump_Click"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrWarn}"
                                BorderBrush="{DynamicResource BrWarnBg}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Tanınmayan disk için TEK TIKLA: baş + yayılmış veri örneklerini otomatik döker (yeni marka tanıtmak için gereken her şey)"/>

                        <Button x:Name="DiagButton" Content="🔍 Oto-Teşhis" Click="OtoTeshis_Click"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrLink}"
                                BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Takılı diski otomatik tanı: marka/format, kamera sayısı, tarih aralığı ve kurtarılabilir mi (✓/✗) — kısa örnekleme ile"/>

                        <Button x:Name="PlayerButton" Content="▶ Oynat" Click="OpenPlayer_Click"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrOkBg}" Foreground="{DynamicResource BrAccentText}"
                                BorderBrush="{DynamicResource BrSelBg}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Gömülü oynatıcı: kurtardığın video dosyasını (.mp4/.h265/.h264) uygulama içinde oynat (her codec)"/>

                        <Button x:Name="LogButton" Content="📋 Log" Click="OpenLog_Click"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText2}"
                                BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"
                                ToolTip="İşlem logu: ne tarandı, ne kaydedildi, ne hata verdi"/>

                        <Button x:Name="CatalogButton" Content="📇 Kataloğa Al" Click="BuildCatalog_Click" Visibility="Collapsed"
                                Height="32" Padding="12,0" Margin="0,0,8,6" Background="{DynamicResource BrPurpleBg}" Foreground="{DynamicResource BrPurple}"
                                BorderBrush="{DynamicResource BrPurpleBg}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Dağınık DVR diskini bir kez baştan sona tarayıp kataloğa alır (gece bırak). Sonra her kayıt anında çıkar. Kaynağa yazmaz."/>

                        <Border x:Name="ExtBorder" Background="{DynamicResource BrPanel}" CornerRadius="6" Padding="8,0" Margin="0,0,8,6" BorderBrush="{DynamicResource BrLine}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Dışa uzantı:" Foreground="{DynamicResource BrDim}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="ExtBox" Width="56" Height="24" VerticalContentAlignment="Center"
                                         Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                                         Padding="6,0" ToolTip="Boş = orijinal uzantı. Örn: mp4, jpg — kopyalarken uzantıyı buna çevirir (video carve hariç)."/>
                            </StackPanel>
                        </Border>

                        <!-- Video: otomatik zaman çizgili .mp4; sadece FPS ayarı (ağır çekim olursa düşür) -->
                        <Border x:Name="FpsBorder" Background="{DynamicResource BrPanel}" CornerRadius="6" Padding="8,0" Margin="0,0,8,6" BorderBrush="{DynamicResource BrLine}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Video FPS:" Foreground="{DynamicResource BrDim}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="FpsBox" Width="58" Height="24" VerticalContentAlignment="Center" IsEditable="True"
                                          Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}"
                                          ToolTip="Kare hızı. Ağır çekim/hızlı oynarsa değiştir (DVR'larda genelde 25, 15 veya 12).">
                                    <ComboBoxItem>6</ComboBoxItem><ComboBoxItem>8</ComboBoxItem><ComboBoxItem>10</ComboBoxItem>
                                    <ComboBoxItem>12</ComboBoxItem><ComboBoxItem>15</ComboBoxItem><ComboBoxItem>20</ComboBoxItem>
                                    <ComboBoxItem IsSelected="True">25</ComboBoxItem><ComboBoxItem>30</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Button x:Name="SaveButton" Grid.Column="1" Content="Seçilenleri Kaydet" Click="SaveSelected_Click"
                            VerticalAlignment="Top" Height="32" Padding="14,0" Margin="8,0,0,0"
                            Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </Grid>

                <!-- Tıklanabilir yol çubuğu (Konum) -->
                <Border Grid.Row="1" Background="{DynamicResource BrBg}" Padding="16,0,16,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Konum:" Foreground="{DynamicResource BrDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ItemsControl x:Name="Breadcrumb">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Text}" Tag="{Binding Path}" Click="Crumb_Click"
                                                Background="Transparent" Foreground="{DynamicResource BrAccentText}" BorderThickness="0"
                                                Cursor="Hand" Padding="3,0" FontSize="12.5"/>
                                        <TextBlock Text="›" Foreground="{DynamicResource BrDim}" FontSize="13" VerticalAlignment="Center" Margin="2,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Arama / filtre (varsayılan gizli; sağ tık veya 🔍 ile açılır) -->
                <Border x:Name="FilterBar" Grid.Row="2" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,1,0,1"
                        Padding="16,6" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ara:" Foreground="{DynamicResource BrDim}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FilterBox" Width="190" Height="28" VerticalContentAlignment="Center"
                                 Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                                 Padding="8,0" TextChanged="Filter_Changed" KeyDown="FilterBox_KeyDown"
                                 ToolTip="ad veya uzantı (ör. jpg, rapor, .mp4). Enter = diskte ara"/>
                        <Button x:Name="SearchButton" Content="Diskte Ara" Click="DiskSearch_Click"
                                Height="28" Padding="12,0" Margin="8,0,0,0" Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrAccentText}"
                                BorderBrush="{DynamicResource BrSelBg}" BorderThickness="1" Cursor="Hand"
                                ToolTip="Tüm klasörleri gezip eşleşen dosyaları bulur"/>
                        <CheckBox x:Name="OnlyDeleted" Content="Sadece silinmiş" Foreground="{DynamicResource BrText2}" FontSize="12.5"
                                  VerticalAlignment="Center" Margin="14,0,0,0" Click="Filter_Changed"/>
                        <TextBlock x:Name="StatsText" Foreground="{DynamicResource BrDim}" FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0"/>
                        <Button Content="Gizle ✕" Click="HideFilter_Click"
                                Height="28" Padding="10,0" Margin="18,0,0,0" Background="Transparent" Foreground="{DynamicResource BrDim}"
                                BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Başlıklar (tıkla = sırala, tekrar tıkla = ters) -->
                <Border Grid.Row="3" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,1,0,1" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="2.4*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.7*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="SelectAll" VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Click="SelectAll_Click" ToolTip="Tümünü seç / bırak"/>
                        <TextBlock Grid.Column="1" Text="" />
                        <Button Grid.Column="2" x:Name="HdrName" Content="AD" Tag="name" Click="Header_Click" Style="{StaticResource HdrBtn}"/>
                        <Button Grid.Column="3" x:Name="HdrCreated" Content="OLUŞTURMA" Tag="created" Click="Header_Click" Style="{StaticResource HdrBtn}"/>
                        <Button Grid.Column="4" x:Name="HdrModified" Content="DEĞİŞTİRME" Tag="modified" Click="Header_Click" Style="{StaticResource HdrBtn}"/>
                        <Button Grid.Column="5" x:Name="HdrSize" Content="BOYUT" Tag="size" Click="Header_Click" Style="{StaticResource HdrBtn}"/>
                        <Button Grid.Column="6" x:Name="HdrType" Content="TÜR" Tag="type" Click="Header_Click" Style="{StaticResource HdrBtn}"/>
                    </Grid>
                </Border>

                <!-- Liste -->
                <ListBox x:Name="FileList" Grid.Row="4" Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="FileList_DoubleClick"
                         SelectionChanged="FileList_SelChanged"
                         PreviewMouseRightButtonDown="FileList_RightDown"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Önizle (sağlamlık)" Click="Preview_Click"/>
                            <Separator/>
                            <MenuItem Header="Hex / Sektörleri gör" Click="ViewSectors_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <Image Grid.Column="1" Source="{Binding IconImage}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding RowColor}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SubText}" Foreground="{DynamicResource BrDim}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSub, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding CreatedText}" Foreground="{DynamicResource BrDim}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" Foreground="{DynamicResource BrDim}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" Foreground="{DynamicResource BrDim}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding TypeText}" Foreground="{DynamicResource BrDim}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Sağ: hızlı önizleme paneli (tıkınca açılır, ✕ ile kapanır) -->
            <Border Grid.Column="2" x:Name="QuickPanel" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid Margin="14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık + kapat -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="ÖNİZLEME" Foreground="{DynamicResource BrDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="✕" Click="CloseQuick_Click" HorizontalAlignment="Right"
                                Width="24" Height="24" Padding="0" Background="Transparent" Foreground="{DynamicResource BrDim}"
                                BorderThickness="0" Cursor="Hand" FontSize="13"/>
                    </Grid>

                    <!-- İçerik: resim / tablo-metin / ikon -->
                    <Border Grid.Row="1" Background="{DynamicResource BrConsoleBg}" CornerRadius="8">
                        <Grid>
                            <Image x:Name="QThumb" Stretch="Uniform" Margin="8" Visibility="Collapsed"/>
                            <TextBox x:Name="QText" IsReadOnly="True" Visibility="Collapsed"
                                     Background="{DynamicResource BrConsoleBg}" Foreground="{DynamicResource BrConsoleTx}" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11.5" Margin="6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"/>
                            <StackPanel x:Name="QIconBox" Orientation="Vertical" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <Image x:Name="QIcon" Width="64" Height="64" HorizontalAlignment="Center"/>
                                <TextBlock Text="Çift tıkla: tam önizleme" Foreground="{DynamicResource BrLine}" FontSize="11.5"
                                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="QHint" Foreground="{DynamicResource BrLine}" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="QName" Foreground="{DynamicResource BrText}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,10,0,4"/>
                    <TextBox Grid.Row="3" x:Name="QInfo" Foreground="{DynamicResource BrOk}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" IsReadOnly="True" IsReadOnlyCaretVisible="True" Cursor="IBeam" BorderThickness="0" Background="Transparent" Padding="0"/>
                    <TextBlock Grid.Row="4" x:Name="QSound" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Tam önizleme" Click="PreviewSelected_Click"
                                Height="30" Padding="10,0" Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrAccentText}"
                                BorderBrush="{DynamicResource BrSelBg}" BorderThickness="1" Cursor="Hand"/>
                        <Button Content="Kaydet" Click="SaveSelected_Click"
                                Height="30" Padding="12,0" Margin="8,0,0,0" Background="{DynamicResource BrAccent}" Foreground="White"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Alt durum + tarama ilerleme çubuğu -->
        <StackPanel Grid.Row="2" Margin="16,8,16,10">
            <!-- Tarama ilerlemesi (UFS tarzı yeşil çubuk + süre/ETA) — yalnız tarama sırasında görünür -->
            <Grid x:Name="ScanPanel" Visibility="Collapsed" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Height="16">
                    <ProgressBar x:Name="ScanBar" Minimum="0" Maximum="100" Value="0"
                                 Background="{DynamicResource BrCard2}" Foreground="{DynamicResource BrOk}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1"/>
                    <TextBlock x:Name="ScanPct" Text="%0" Foreground="{DynamicResource BrOk}" FontSize="10.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBox x:Name="ScanInfo" Grid.Column="1" Foreground="{DynamicResource BrOk}" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Consolas" IsReadOnly="True" IsReadOnlyCaretVisible="True" Cursor="IBeam" BorderThickness="0" Background="Transparent" Padding="0"/>
                <Button x:Name="StopButton" Grid.Column="2" Content="■ Durdur" Click="StopScan_Click"
                        Height="24" Padding="10,0" Margin="12,0,0,0" Background="{DynamicResource BrBadBg}" Foreground="{DynamicResource BrBad}"
                        BorderBrush="{DynamicResource BrBadBg}" BorderThickness="1" Cursor="Hand" FontSize="11.5"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Salt-okunur ama seçilip kopyalanabilir (teşhis satırını Ctrl+C ile al) -->
                <TextBox x:Name="Status" Grid.Column="0" Foreground="{DynamicResource BrOk}" FontSize="12" TextWrapping="Wrap"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                         IsReadOnlyCaretVisible="True" Cursor="IBeam"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas"/>
                <TextBlock x:Name="SizeStatus" Grid.Column="1" Foreground="{DynamicResource BrAccentText}" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Uzun işlemler için EKRAN ORTASINDA yeşil yüzdelik çubuk (Hikvision blok taraması vb.) -->
        <Border x:Name="CenterProgress" Visibility="Collapsed" Background="#CC0B0F14" Panel.ZIndex="100">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource BrCard}" CornerRadius="12" BorderBrush="{DynamicResource BrLine}" BorderThickness="1">
                <StackPanel Margin="30" VerticalAlignment="Center">
                    <TextBlock x:Name="CenterLabel" Text="İşleniyor…" Foreground="{DynamicResource BrLink}"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="CenterBar" Height="24" Minimum="0" Maximum="100" Value="0"
                                 Background="{DynamicResource BrBg}" Foreground="{DynamicResource BrOk}" BorderThickness="0"/>
                    <TextBlock x:Name="CenterPct" Text="%0" Foreground="{DynamicResource BrOk}" FontSize="14"
                               FontWeight="Bold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    <TextBox x:Name="CenterInfo" Text="" Foreground="{DynamicResource BrOk}" FontSize="12"
                               Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Consolas" IsReadOnly="True" IsReadOnlyCaretVisible="True" Cursor="IBeam" BorderThickness="0" Background="Transparent" Padding="0"/>
                    <Button x:Name="CenterStop" Content="■ Durdur" Click="StopScan_Click"
                            Visibility="Collapsed" Margin="0,16,0,0" Padding="18,6" HorizontalAlignment="Center"
                            Background="{DynamicResource BrBadBg}" Foreground="{DynamicResource BrBad}" BorderBrush="{DynamicResource BrBadBg}" BorderThickness="1"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
