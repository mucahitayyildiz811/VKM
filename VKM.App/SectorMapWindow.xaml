<Window x:Class="VKM.App.SectorMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sektör Görüntüleyici" Height="760" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrBg}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BrHead}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sektör Görüntüleyici" Foreground="{DynamicResource BrText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource BrDim}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Genel harita: tıkla, altta o sektöre git -->
        <Border Grid.Row="1" Margin="20,16,20,8" Height="140" Background="{DynamicResource BrConsoleBg}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" CornerRadius="8">
            <Image x:Name="MapImage" Stretch="Fill" Margin="6" Cursor="Cross"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   MouseLeftButtonDown="Map_MouseDown"/>
        </Border>

        <!-- Hex içerik: sadece DİKEY (tekerlek + sağdaki çubuk) -->
        <Grid Grid.Row="2" Margin="20,0,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BrConsoleBg}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" CornerRadius="8"
                    ClipToBounds="True" PreviewMouseWheel="Hex_Wheel">
                <TextBlock x:Name="HexText" Foreground="{DynamicResource BrText2}" FontFamily="Consolas" FontSize="12.5"
                           TextWrapping="NoWrap" Margin="12,10"/>
            </Border>
            <ScrollBar Grid.Column="1" x:Name="VBar" Orientation="Vertical" Width="18" Margin="8,0,0,0"
                       Minimum="0" Maximum="0" SmallChange="1" LargeChange="40" ValueChanged="VBar_Changed"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="20,0,20,14">
            <Rectangle x:Name="HlLegend" Width="14" Height="14" Fill="{DynamicResource BrWarn}" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="HlLegendText" Text="Bu dosya" Foreground="{DynamicResource BrDim}" FontSize="12" Margin="6,0,16,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Rectangle Width="14" Height="14" Fill="{DynamicResource BrBad}" VerticalAlignment="Center"/>
            <TextBlock Text="Şu an" Foreground="{DynamicResource BrDim}" FontSize="12" Margin="6,0,16,0" VerticalAlignment="Center"/>
            <TextBox x:Name="Status" Foreground="{DynamicResource BrOk}" FontSize="12" VerticalAlignment="Center" FontFamily="Consolas" IsReadOnly="True" IsReadOnlyCaretVisible="True" Cursor="IBeam" BorderThickness="0" Background="Transparent" Padding="0"/>
        </StackPanel>
    </Grid>
</Window>
