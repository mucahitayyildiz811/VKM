<Window x:Class="VKM.App.VideoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video önizleme" Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrBg}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="NameText" Grid.Row="0" Foreground="{DynamicResource BrText}" FontSize="14" FontWeight="SemiBold"
                   Margin="16,14,16,8" TextTrimming="CharacterEllipsis"/>

        <Border Grid.Row="1" Background="#000000" Margin="16,0,16,8" CornerRadius="8">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                          Stretch="Uniform" ScrubbingEnabled="True"
                          MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed" MediaEnded="Player_MediaEnded"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,8">
            <Button Content="▶ Oynat" Click="Play_Click" Height="30" Padding="14,0" Margin="0,0,8,0"
                    Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="⏸ Duraklat" Click="Pause_Click" Height="30" Padding="14,0" Margin="0,0,8,0"
                    Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText2}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
            <Button Content="⏹ Dur" Click="Stop_Click" Height="30" Padding="14,0"
                    Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText2}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>

        <TextBox x:Name="Status" Grid.Row="3" Foreground="{DynamicResource BrOk}" FontSize="12" Margin="16,0,16,14" TextWrapping="Wrap" FontFamily="Consolas" IsReadOnly="True" IsReadOnlyCaretVisible="True" Cursor="IBeam" BorderThickness="0" Background="Transparent" Padding="0"/>
    </Grid>
</Window>
