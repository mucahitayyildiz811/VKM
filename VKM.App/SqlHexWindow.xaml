<Window x:Class="VKM.App.SqlHexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Hex / Sayfa Görüntüleyici" Height="640" Width="900"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FileLabel" Grid.Column="0" Foreground="{DynamicResource BrDim}" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Sayfa:" Foreground="{DynamicResource BrText2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="PageBox" Width="90" Height="28" Text="0" VerticalContentAlignment="Center"
                         Background="{DynamicResource BrPanel}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" Padding="6,0"/>
                <Button Content="Git" Click="Go_Click" Height="28" Padding="12,0" Margin="6,0,0,0"
                        Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="◀" Click="Prev_Click" Height="28" Padding="10,0" Margin="6,0,0,0"
                        Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
                <Button Content="▶" Click="Next_Click" Height="28" Padding="10,0" Margin="4,0,0,0"
                        Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
                <Button x:Name="AnalyzeBtn" Content="🧬 Sayfa Analizi" Click="Analyze_Click" Height="28" Padding="12,0" Margin="12,0,0,0"
                        Background="{DynamicResource BrPurple}" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="Tüm sayfaları tara: tip dağılımı + en büyük nesneler + tahmini DB adı"/>
                <Button x:Name="TablesBtn" Content="📋 Tablolar" Click="Tables_Click" Height="28" Padding="12,0" Margin="6,0,0,0"
                        Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="sysschobjs'tan nesne/tablo adlarını çıkar (id + ad)"/>
                <TextBlock Text="obj:" Foreground="{DynamicResource BrText2}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="ObjBox" Width="70" Height="28" VerticalContentAlignment="Center"
                         Background="{DynamicResource BrPanel}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" Padding="6,0"
                         ToolTip="Sayfa Analizi'ndeki 'en büyük nesneler' listesinden bir obj id yaz"/>
                <Button x:Name="RowsBtn" Content="💾 Satır Çıkar" Click="Rows_Click" Height="28" Padding="10,0" Margin="4,0,0,0"
                        Background="{DynamicResource BrSelBg}" Foreground="{DynamicResource BrText}" BorderThickness="0" Cursor="Hand"
                        ToolTip="Bu obj id'nin veri sayfalarındaki kayıtları çöz → CSV"/>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="Busy" Grid.Row="1" Height="4" Visibility="Collapsed"
                     Background="{DynamicResource BrPanel}" Foreground="{DynamicResource BrPurple}" BorderThickness="0" Margin="0,0,0,8"/>

        <!-- çözülen başlık (kopyalanabilir) -->
        <Border Grid.Row="2" Background="{DynamicResource BrPanel}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <TextBox x:Name="HdrText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                     Foreground="{DynamicResource BrLink}" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
        </Border>

        <!-- hex (kopyalanabilir) -->
        <Border Grid.Row="3" Background="{DynamicResource BrConsoleBg}" CornerRadius="6" BorderBrush="{DynamicResource BrLine}" BorderThickness="1">
            <TextBox x:Name="HexText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     Background="Transparent" Foreground="{DynamicResource BrConsoleTx}" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="10"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>
