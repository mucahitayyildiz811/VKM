<Window x:Class="VKM.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İşlem Logu" Height="520" Width="820" Background="{DynamicResource BrConsoleBg}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="İşlem Logu — ne tarandı, ne kaydedildi, ne hata verdi"
                   Foreground="{DynamicResource BrConsoleTx}" FontSize="12.5" Margin="2,0,0,8"/>
        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 Background="Transparent" Foreground="{DynamicResource BrOk}" FontFamily="Consolas" FontSize="12"
                 BorderBrush="{DynamicResource BrLine}" BorderThickness="0" Padding="8"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnlyCaretVisible="True" Cursor="IBeam"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Temizle" Click="Clear_Click" Width="90" Height="30" Margin="0,0,8,0"
                    Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
            <Button Content="Kopyala" Click="Copy_Click" Width="90" Height="30" Margin="0,0,8,0"
                    Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
            <Button Content="Kapat" Click="Close_Click" Width="90" Height="30"
                    Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
