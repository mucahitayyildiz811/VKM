<UserControl x:Class="VKM.App.RaidPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VKM.App"
             Background="{DynamicResource BrBg}">
    <UserControl.Resources>
        <local:RaidColumns x:Key="Cols"/>
        <local:RaidIconConverter x:Key="RaidIcon"/>
        <Style x:Key="ColSplit" TargetType="GridSplitter">
            <Setter Property="Width" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Background" Value="{DynamicResource BrLine}"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ToolTip" Value="Sürükle: sütunu genişlet / daralt"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Background" Value="{DynamicResource BrBtn}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnMain" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource BrAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Açılır/kapanır ok -->
        <Style x:Key="Expander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <TextBlock x:Name="g" Text="▸" Foreground="{DynamicResource BrDim}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="g" Property="Text" Value="▾"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ağaç satırı: tam genişlik (sütunlar hizalı kalsın), girinti düğümün kendi derinliğinden -->
        <Style x:Key="RowItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" Padding="4,3" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Indent}"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Exp" Grid.Column="1" Style="{StaticResource Expander}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ContentPresenter Grid.Column="2" ContentSource="Header" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="Items"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Exp" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrSelBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="{Binding LogH, Source={StaticResource Cols}, Mode=TwoWay}" MinHeight="40"/>
        </Grid.RowDefinitions>

        <!-- Üst çubuk -->
        <Border Grid.Row="0" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1" Padding="12,10,12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0">
                    <Button x:Name="ScanBtn" Content="🔄 Diskleri tara · RAID bul" Style="{StaticResource BtnMain}" Click="Scan_Click"
                            ToolTip="Tüm diskleri okur (salt okunur), RAID/NAS/LVM yapılarını otomatik kurar. Üst verisi olmayan eş boyutlu diskleri çözücüyle çözer."/>
                    <Button Content="＋ İmaj ekle" Style="{StaticResource Btn}" Click="AddImage_Click" ToolTip="RAID üyesi olarak disk imajı ekle (.img/.dd/.bin/.raw/.001)"/>
                    <Button Content="🧩 Seçili diskleri çöz" Style="{StaticResource Btn}" Click="SolveSelected_Click"
                            ToolTip="Kutucuğu işaretli diskler üzerinde üst verisiz RAID çözücüsünü çalıştırır (HP, IBM, Adaptec, bozuk kontrolcü…)"/>
                    <Button Content="⚙ Elle RAID kur" Style="{StaticResource Btn}" Click="Manual_Click"/>
                    <Button Content="📂 Yapılandırma yükle" Style="{StaticResource Btn}" Click="LoadCfg_Click"/>
                    <Button x:Name="StopBtn" Content="■ Durdur" Style="{StaticResource Btn}" Click="Stop_Click" IsEnabled="False"/>
                    <Button Content="◧ Ayrıntı paneli" Style="{StaticResource Btn}" Click="TogglePanel_Click" ToolTip="Sağdaki ayrıntı panelini aç / kapat"/>
                    <Button Content="↺ Düzeni sıfırla" Style="{StaticResource Btn}" Click="ResetLayout_Click" ToolTip="Sütun ve panel genişliklerini varsayılana döndür"/>
                </WrapPanel>
                <TextBlock Grid.Column="1" x:Name="StatusText" Foreground="{DynamicResource BrDim}" VerticalAlignment="Center" Margin="10,0,4,6" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Ağaç + ayrıntı -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="RightCol" Width="{Binding Right, Source={StaticResource Cols}, Mode=TwoWay}" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- sütun başlıkları (aralardaki çizgileri sürükleyerek genişlet) -->
                <Border Background="{DynamicResource BrHead}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1" Padding="26,5,25,5">
                    <Grid TextElement.Foreground="{DynamicResource BrDim}" TextElement.FontSize="11.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="{Binding Detail, Source={StaticResource Cols}, Mode=TwoWay}" MinWidth="30"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="{Binding Start, Source={StaticResource Cols}, Mode=TwoWay}" MinWidth="30"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="{Binding Size, Source={StaticResource Cols}, Mode=TwoWay}" MinWidth="30"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="{Binding Status, Source={StaticResource Cols}, Mode=TwoWay}" MinWidth="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ad" Margin="4,0"/>
                        <GridSplitter Grid.Column="1" Style="{StaticResource ColSplit}"/>
                        <TextBlock Grid.Column="2" Text="Açıklama" Margin="4,0"/>
                        <GridSplitter Grid.Column="3" Style="{StaticResource ColSplit}"/>
                        <TextBlock Grid.Column="4" Text="Başlangıç (sektör)" TextAlignment="Right" Margin="4,0"/>
                        <GridSplitter Grid.Column="5" Style="{StaticResource ColSplit}"/>
                        <TextBlock Grid.Column="6" Text="Boyut" TextAlignment="Right" Margin="4,0"/>
                        <GridSplitter Grid.Column="7" Style="{StaticResource ColSplit}"/>
                        <TextBlock Grid.Column="8" Text="Durum / sağlık" Margin="4,0"/>
                    </Grid>
                </Border>
                <TreeView Grid.Row="1" x:Name="Tree" Background="Transparent" BorderThickness="0" Padding="4"
                          ItemContainerStyle="{StaticResource RowItem}"
                          SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick"
                          PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown" ContextMenuOpening="Tree_ContextMenuOpening"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          VirtualizingPanel.IsVirtualizing="False">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="TreeMenu"/>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:RaidNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource RowItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="60"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="{Binding Detail, Source={StaticResource Cols}}"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="{Binding Start, Source={StaticResource Cols}}"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="{Binding Size, Source={StaticResource Cols}}"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="{Binding Status, Source={StaticResource Cols}}"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Visibility="{Binding CheckVisibility}" VerticalAlignment="Center" Margin="0,0,6,0"
                                              ToolTip="'Seçili diskleri çöz' için işaretle"/>
                                    <ContentControl Content="{Binding Icon, Converter={StaticResource RaidIcon}}" Width="19" Height="19" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrText}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource BrDim}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}"/>
                                <TextBlock Grid.Column="4" Text="{Binding StartText}" Foreground="{DynamicResource BrDim}" FontSize="12" TextAlignment="Right" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding SizeText}" Foreground="{DynamicResource BrText}" FontSize="12.5" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="8" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Status}"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock Grid.Row="1" x:Name="EmptyText" Foreground="{DynamicResource BrDim}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Text="Diskler taranınca RAID'ler burada otomatik görünür.&#10;Diskleri takın, '🔄 Diskleri tara' deyin — başka bir şey yapmanız gerekmez."/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{DynamicResource BrLine}" Cursor="SizeWE" ShowsPreview="False"
                          ToolTip="Sürükle: sol ağaç / sağ ayrıntı panelini genişlet. Çift tık: sağ paneli aç/kapat" MouseDoubleClick="Split_DoubleClick"/>

            <!-- Ayrıntı -->
            <Border Grid.Column="2" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1,0,0,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetTitle" Text="Seçili öğe" Foreground="{DynamicResource BrText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <WrapPanel Grid.Row="1" Margin="0,10,0,4">
                        <Button x:Name="OpenBtn" Content="📂 Veri Kurtarma'da aç" Style="{StaticResource BtnMain}" Click="OpenNode_Click" IsEnabled="False"/>
                        <Button x:Name="HexBtn" Content="🔎 Hex" Style="{StaticResource Btn}" Click="Hex_Click" IsEnabled="False"/>
                        <Button x:Name="ImageBtn" Content="💾 İmaj al" Style="{StaticResource Btn}" Click="Image_Click" IsEnabled="False" ToolTip="Bu aygıtı (sanal RAID dâhil) ham imaj dosyasına kaydet"/>
                        <Button x:Name="ParityBtn" Content="🧪 Parite kontrolü" Style="{StaticResource Btn}" Click="Parity_Click" IsEnabled="False"/>
                        <Button x:Name="EditBtn" Content="⚙ Ayarları değiştir" Style="{StaticResource Btn}" Click="Edit_Click" IsEnabled="False"/>
                        <Button x:Name="SaveCfgBtn" Content="💾 Yapılandırmayı kaydet" Style="{StaticResource Btn}" Click="SaveCfg_Click" IsEnabled="False"/>
                        <Button x:Name="StaleBtn" Content="🔎 Eski diski bul" Style="{StaticResource Btn}" Click="Stale_Click" IsEnabled="False"
                                ToolTip="Diziden önce düşmüş (bayat) diski bulur — onu eksik sayıp pariteden kurar"/>
                        <Button x:Name="OldBtn" Content="▦ Eski RAID yapısı" Style="{StaticResource Btn}" Click="Old_Click" IsEnabled="False"/>
                        <Button x:Name="PropBtn" Content="ℹ Özellikler" Style="{StaticResource Btn}" Click="Props_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <TextBox Grid.Row="2" x:Name="DetText" IsReadOnly="True" Background="{DynamicResource BrBg}" Foreground="{DynamicResource BrText2}" BorderBrush="{DynamicResource BrLine}"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource BrLine}" Cursor="SizeNS" ToolTip="Sürükle: log alanını büyüt / küçült"/>

        <!-- Log (yeşil, kopyalanabilir) -->
        <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" Background="{DynamicResource BrConsoleBg}" Foreground="{DynamicResource BrConsoleFg}" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10,6"/>
    </Grid>
</UserControl>
