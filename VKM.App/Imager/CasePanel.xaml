<UserControl x:Class="VKM.App.CasePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource BrBg}" FontFamily="Segoe UI">
    <DockPanel>
        <!-- ÜST: iş bilgisi + imaj kontrolleri (PC-3000 / UFS gibi) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrHead}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1" Padding="12,7">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayBtn" Click="Play_Click" Height="34" Padding="16,0" Cursor="Hand"
                            Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                            Content="▶ İmaj Al (0→son)" ToolTip="Diski baştan sona imajla — arka planda; root'u gezmeye devam edebilirsin"/>
                    <Button x:Name="PauseBtn" Click="Pause_Click" Height="34" Padding="12,0" Margin="7,0,0,0" Cursor="Hand" IsEnabled="False"
                            Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Content="⏸ Duraklat"/>
                    <Button x:Name="StopBtn" Click="Stop_Click" Height="34" Padding="12,0" Margin="7,0,0,0" Cursor="Hand" IsEnabled="False"
                            Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Content="⏹ Durdur"/>
                    <Button x:Name="RetryBtn" Click="Retry_Click" Height="34" Padding="12,0" Margin="7,0,0,0" Cursor="Hand" IsEnabled="False"
                            Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Content="↻ Arızalıları dene"/>
                    <Border Width="1" Background="{DynamicResource BrLine}" Margin="12,4" />
                    <TextBlock Text="Hız" Foreground="{DynamicResource BrDim}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                    <Slider x:Name="SpeedSlider" Width="110" Minimum="0" Maximum="120" Value="0" VerticalAlignment="Center"
                            ValueChanged="Speed_Changed" TickFrequency="10" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="SpeedTxt" Text="hızlı" Foreground="{DynamicResource BrDim}" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
                    <TextBlock x:Name="MbpsLbl" Text="" Foreground="{DynamicResource BrText}" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="CaseLbl" Text="" Foreground="{DynamicResource BrText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ALT: Log | Harita | Durum (UFS gibi) -->
        <GridSplitter DockPanel.Dock="Bottom" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource BrLine}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
        <Border DockPanel.Dock="Bottom" Height="240" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,1,0,0">
            <TabControl x:Name="BottomTabs" Background="Transparent" BorderThickness="0">
                <!-- LOG -->
                <TabItem Header="Log">
                    <Border Background="{DynamicResource BrConsoleBg}">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="10,6">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource BrConsoleTx}" FontFamily="Consolas" FontSize="11.5" Width="62"/>
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </TabItem>
                <!-- HARİTA (sektör haritası + kafalar) -->
                <TabItem Header="Harita">
                    <DockPanel Margin="8">
                        <!-- kafalar sağda (pc3000 gibi aç/kapa) -->
                        <Border DockPanel.Dock="Right" Width="76" Background="{DynamicResource BrCard}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" CornerRadius="8" Margin="8,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Kafalar" Foreground="{DynamicResource BrDim}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="HeadsPanel" Margin="8,0"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <!-- alt durum çubuğu -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrCard}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Okunan: " Foreground="{DynamicResource BrDim}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OkLbl" Text="0" Foreground="{DynamicResource BrOk}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="   Arızalı: " Foreground="{DynamicResource BrDim}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BadLbl" Text="0" Foreground="{DynamicResource BrBad}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="   LBA: " Foreground="{DynamicResource BrDim}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LbaLbl" Text="-" Foreground="{DynamicResource BrText}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HeadLbl" Text="" Foreground="{DynamicResource BrDim}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Border Width="1" Background="{DynamicResource BrLine}" Margin="12,2"/>
                                <Border Width="200" Height="12" Background="{DynamicResource BrLine}" CornerRadius="6" VerticalAlignment="Center">
                                    <Border x:Name="ProgFill" Width="0" Height="12" HorizontalAlignment="Left" Background="{DynamicResource BrOk}" CornerRadius="6"/>
                                </Border>
                                <TextBlock x:Name="PctLbl" Text="0.0%" Foreground="{DynamicResource BrText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- harita -->
                        <Border Background="{DynamicResource BrConsoleBg}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" CornerRadius="8">
                            <Image x:Name="MapImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="4"/>
                        </Border>
                    </DockPanel>
                </TabItem>
                <!-- DURUM (geometri / UFS Status gibi) -->
                <TabItem Header="Durum">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                        <TextBlock x:Name="StatusTxt" Foreground="{DynamicResource BrText}" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ORTA: ağaç + dosyalar (kurtarma tarayıcısı) -->
        <ContentControl x:Name="BrowseHost"/>
    </DockPanel>
</UserControl>
