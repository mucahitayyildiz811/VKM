<Window x:Class="VKM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VKM.App"
        Title="Veri Kurtarma Merkezi" Height="700" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrBg}" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Modül kutusu (sade; seçili olan vurgulanır) -->
        <Style x:Key="ModuleItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrDim}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{DynamicResource BrCard}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrSelBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrAccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="{DynamicResource BrHead}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1,1,1,0"
                                CornerRadius="7,7,0,0" Margin="0,0,3,0" Padding="14,7">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BrSelBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="LogRow" Height="170"/>
        </Grid.RowDefinitions>

        <!-- Üst başlık + butonlar -->
        <Border Grid.Row="0" Background="{DynamicResource BrHead}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource BrAccent}" VerticalAlignment="Center">
                        <TextBlock Text="VKM" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Veri Kurtarma Merkezi" Foreground="{DynamicResource BrText}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenImageButton" Content="＋ İmaj Aç" Click="OpenImage_Click"
                            Height="32" Padding="16,0" Margin="0,0,8,0"
                            Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" Cursor="Hand"
                            ToolTip="Disk imajı aç (.img/.dd/.001/.bin/.raw/.vhd/.vhdx/.vmdk/.vdi…)"/>
                    <Button x:Name="RefreshButton" Content="Yenile" Click="RefreshButton_Click"
                            Height="32" Padding="16,0"
                            Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
                    <local:ThemeToggle x:Name="ThemeSwitch" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Modüller: üstte yatay bar (kutular) -->
        <Border Grid.Row="1" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <local:ModuleBar Grid.Column="0" x:Name="ModuleBar"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                <Border Grid.Column="1" Background="{DynamicResource BrShieldBg}" BorderBrush="{DynamicResource BrShieldLn}" BorderThickness="1" CornerRadius="8"
                        Margin="10,0,0,0" Padding="11,6" VerticalAlignment="Center">
                    <TextBlock Text="🛡 Yazma koruması" Foreground="{DynamicResource BrShieldTx}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- MODÜL İÇERİĞİ -->
        <Grid Grid.Row="2">
            <Grid>
              <!-- Veri Kurtarma modülü -->
              <Grid x:Name="VeriKurtarmaPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DevCol" Width="*" MinWidth="320"/>
                    <ColumnDefinition x:Name="MidCol" Width="0"/>
                    <ColumnDefinition x:Name="TabCol" Width="0"/>
                </Grid.ColumnDefinitions>

            <local:RaidPanel x:Name="DevTree" Grid.Column="0"/>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BrLine}"/>

            <Grid Grid.Column="2">
                <TextBlock x:Name="EmptyHint" Text="Soldan bir diske ya da bölüme çift tıkla — burada sekmede açılır.&#10;Veya üstten ＋ İmaj Aç."
                           Foreground="{DynamicResource BrDim}" FontSize="13" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TabControl x:Name="MainTabs" Background="{DynamicResource BrBg}" BorderThickness="0" Padding="0" Margin="8,8,8,8"/>
            </Grid>
              </Grid>

              <!-- CCTV modülü -->
              <Grid x:Name="CctvPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="DVR DİSKLERİ" Foreground="{DynamicResource BrDim}" FontSize="11" FontWeight="SemiBold" Margin="16,14,16,8"/>

                        <Button Grid.Row="1" Content="＋ DVR İmajı Aç" Click="Cctv_OpenImage_Click"
                                Margin="12,0,12,8" Padding="10,7" Background="{DynamicResource BrAccent}" Foreground="White"
                                BorderThickness="0" Cursor="Hand" FontSize="12.5"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CctvDiskList" Margin="8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrCard}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                Cursor="Hand" MouseLeftButtonDown="Cctv_DiskRow_Click" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Model}" Foreground="{DynamicResource BrText}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource BrDim}" FontSize="11"/>
                                                        <TextBlock Text="  ·  " Foreground="{DynamicResource BrDim}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Interface}" Foreground="{DynamicResource BrDim}" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="9" Height="9" CornerRadius="5" Background="{Binding HealthColor}"
                                                        VerticalAlignment="Center" ToolTip="{Binding SmartLine}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="CCTV — DVR Video Kurtarma" Foreground="{DynamicResource BrText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="{DynamicResource BrDim}" FontSize="13" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Soldan bir DVR diskine çift tıkla ya da '＋ DVR İmajı Aç' de — video taraması kendiliğinden başlar."/>
                    <TextBlock Foreground="{DynamicResource BrDim}" FontSize="12.5" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Dosya sistemine, uzantıya ya da markaya bakmaz. Disk silinmiş/formatlı/bozuk olsa bile içerikteki H.264 karelerini bulur, .mp4 + oynar .h264 olarak çıkarır. Hikvision, Dahua ve generic DVR'lar."/>
                </StackPanel>
              </Grid>

              <local:MssqlPanel x:Name="SqlPanel" Visibility="Collapsed"/>
              <local:SmartPanel x:Name="SmartPanelCtl" Visibility="Collapsed"/>
              <local:ImagerPanel x:Name="ImagerPanelCtl" Visibility="Collapsed"/>

              <Border x:Name="ModuleStub" Background="{DynamicResource BrBg}" Visibility="Collapsed">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock x:Name="StubTitle" Foreground="{DynamicResource BrText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="StubText" Foreground="{DynamicResource BrDim}" FontSize="13" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                  </StackPanel>
              </Border>
            </Grid>
        </Grid>

        <!-- sürükle: log yüksekliği -->
        <GridSplitter x:Name="LogSplit" Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource BrLine}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

        <!-- UFS tarzı alt günlük (log) -->
        <Border Grid.Row="4" Background="{DynamicResource BrPanel}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource BrHead}" BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1" Padding="12,5">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 Günlük" Foreground="{DynamicResource BrText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LogCount" Foreground="{DynamicResource BrDim}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Temizle" Click="LogClear_Click" Height="24" Padding="10,0" FontSize="11"
                                    Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
                            <Button x:Name="LogToggle" Content="▾" Click="LogToggle_Click" Width="26" Height="24" Margin="8,0,0,0" FontSize="11"
                                    Background="{DynamicResource BrBtn}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand" ToolTip="Gizle / göster"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,6">
                    <ItemsControl x:Name="LogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource BrDim}" FontFamily="Consolas" FontSize="11.5" Width="62"/>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
