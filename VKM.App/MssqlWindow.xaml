<UserControl x:Class="VKM.App.MssqlPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16" Background="{DynamicResource BrBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="{DynamicResource BrText}" FontSize="16" FontWeight="Bold"
                   Text="SQL &amp; Veritabanı — Otomatik Kurtarma  (Modül 8)"/>
        <TextBlock Grid.Row="1" Foreground="{DynamicResource BrDim}" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,12"
                   Text="Dosya(ları) seç — gerisini program yapar. Teşhis → en az kayıplı yöntem → geçerli .bak üretir. Orijinale dokunulmaz."/>

        <!-- LocalDB durumu -->
        <Border Grid.Row="2" Background="{DynamicResource BrBtn}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LocalDbStatus" Foreground="{DynamicResource BrWarn}" FontSize="12" VerticalAlignment="Center"
                           Text="LocalDB kontrol ediliyor…"/>
                <Button x:Name="CheckBtn" Content="Tekrar kontrol" Click="Check_Click"
                        Height="26" Padding="10,0" Margin="12,0,0,0"
                        Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Dosya seç + Referans (opsiyonel) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FileBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" IsReadOnly="True"
                         Background="{DynamicResource BrPanel}" Foreground="{DynamicResource BrText}" BorderBrush="{DynamicResource BrLine}" Padding="10,0"
                         Text="Henüz dosya seçilmedi"/>
                <Button Grid.Column="1" x:Name="PickBtn" Content="📂 Dosya Seç" Click="Pick_Click" Height="34" Padding="18,0" Margin="8,0,0,0" MinWidth="150"
                        Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                <Button Grid.Column="2" x:Name="FolderBtn" Content="📁 Klasör Seç" Click="PickFolder_Click" Height="34" Padding="14,0" Margin="8,0,0,0"
                        Background="{DynamicResource BrAccent}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                        ToolTip="Klasördeki (alt klasörler dahil) tüm MDF'ler — çıktılar VKM_KURTARILAN klasörüne, yarıda kalırsa kaldığı yerden devam"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RefBox" Grid.Column="0" Height="30" VerticalContentAlignment="Center" IsReadOnly="True"
                         Background="{DynamicResource BrPanel}" Foreground="{DynamicResource BrDim}" BorderBrush="{DynamicResource BrLine}" Padding="10,0"
                         Text="Referans dosya (Opsiyonel) — aynı programın sağlam .bak / .mdf'si. Seçilirse yapı (ID, PK, index, prosedür) oradan alınır."/>
                <Button Grid.Column="1" x:Name="RefBtn" Content="📎 Referans Seç" Click="PickRef_Click" Height="30" Padding="12,0" Margin="8,0,0,0" MinWidth="150"
                        Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrText2}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand"/>
                <Button Grid.Column="2" x:Name="RefClearBtn" Content="✕" Click="ClearRef_Click" Height="30" Width="30" Margin="6,0,0,0"
                        Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrBad}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand" ToolTip="Referansı kaldır"/>
            </Grid>
        </StackPanel>

        <!-- ANA DÜĞME + müşteride geri yükleme -->
        <Grid Grid.Row="4" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="RecoverBtn" Content="🚀 Otomatik Kurtar → .bak" Click="AutoRecover_Click"
                    Height="46" IsEnabled="False"
                    Background="{DynamicResource BrPurple}" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontSize="15" FontWeight="Bold"/>
            <Button Grid.Column="1" x:Name="InstallBtn" Content="🖥 Müşteride Geri Yükle" Click="Install_Click"
                    Height="46" Padding="16,0" Margin="8,0,0,0"
                    Background="{DynamicResource BrLink}" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="13.5" FontWeight="SemiBold"
                    ToolTip="Müşterinin bilgisayarında çalıştır: .bak'ları seç → SQL Server'ı kendisi bulur, bozuk eski kayıtları temizler, geri yükler, program girişlerini (kullanıcıları) bağlar. SSMS gerekmez."/>
        </Grid>

        <!-- Gelişmiş araçlar (ikincil) -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock Text="Gelişmiş:" Foreground="{DynamicResource BrDim}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="HexBtn" Content="🔎 Hex / Sayfa" Click="Hex_Click" Height="26" Padding="10,0" Margin="0,0,6,0"
                    Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrText2}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand" FontSize="11.5"/>
            <Button x:Name="TeshisBtn" Content="🔬 Teşhis" Click="Teshis_Click" Height="26" Padding="10,0"
                    Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrText2}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand" FontSize="11.5"/>
            <Button x:Name="FixBakBtn" Content="🔧 Mevcut .bak'ı Onar" Click="FixBak_Click" Height="26" Padding="10,0" Margin="6,0,0,0"
                    Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrText2}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand" FontSize="11.5"
                    ToolTip="Zaten kurtarılmış/teslim edilmiş bir .bak'ı baştan taramadan düzeltir: Fiş Bütünleme + Fiş tipi + başlık tutarı → yeni _onarildi.bak"/>
            <Button x:Name="ExcelBtn" Content="📊 Excel'e Aktar" Click="Excel_Click" Height="26" Padding="10,0" Margin="6,0,0,0"
                    Background="{DynamicResource BrLine}" Foreground="{DynamicResource BrText2}" BorderBrush="{DynamicResource BrLine}" BorderThickness="1" Cursor="Hand" FontSize="11.5"
                    ToolTip="Bir ya da birçok .bak'ı Excel'e aktarır: Yevmiye Defteri + Mizan + Hesap Planı (3 sayfalı .xlsx). Orka açmasa da müşaviye teslim için."/>
            <TextBlock Text="Hedef SQL:" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{DynamicResource BrDim}" FontSize="11.5"/>
            <ComboBox x:Name="TargetBox" Width="150" Height="24" FontSize="11.5" SelectedIndex="0" SelectionChanged="Target_Changed"
                      ToolTip="Müşterinin SQL sürümü. .bak bu sürümde (ve üstünde) açılır. Daha eski formatta üretilmiş .bak yeni sürümde de açılır.">
                <ComboBoxItem Content="Otomatik (en eski)" Tag="0"/>
                <ComboBoxItem Content="2016" Tag="13"/>
                <ComboBoxItem Content="2017" Tag="14"/>
                <ComboBoxItem Content="2019" Tag="15"/>
                <ComboBoxItem Content="2022 ve üstü" Tag="16"/>
            </ComboBox>
            <CheckBox x:Name="GhostChk" Content="Silinmişleri de tara" IsChecked="False" VerticalAlignment="Center" Margin="16,0,0,0"
                      Foreground="{DynamicResource BrText2}" FontSize="11.5" Cursor="Hand"
                      ToolTip="İşaretliyse silinmiş (hayalet) kayıtlar da bulunur ve ayrı TABLO__SILINEN tablolarına yazılır. İşaretsizse aranmaz."/>
            <Button x:Name="StopBtn" Content="■ Durdur" Click="Stop_Click" Height="26" Padding="12,0" Margin="16,0,0,0" Visibility="Collapsed"
                    Background="{DynamicResource BrBadBg}" Foreground="{DynamicResource BrBad}" BorderBrush="{DynamicResource BrBadBg}" BorderThickness="1" Cursor="Hand" FontSize="11.5"
                    ToolTip="Şu anki dosya bitince durur. Tekrar başlatınca biten dosyalar atlanır."/>
        </StackPanel>

        <!-- Log (yeşil, kopyalanabilir) -->
        <Border Grid.Row="6" Background="{DynamicResource BrConsoleBg}" CornerRadius="6" BorderBrush="{DynamicResource BrLine}" BorderThickness="1">
            <TextBox x:Name="LogText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Background="Transparent" Foreground="{DynamicResource BrOk}" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="10"
                     VerticalScrollBarVisibility="Auto"/>
        </Border>

        <ProgressBar x:Name="Busy" Grid.Row="7" Height="5" IsIndeterminate="False" Visibility="Collapsed"
                     Background="{DynamicResource BrPanel}" Foreground="{DynamicResource BrPurple}" BorderThickness="0" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
