<Window x:Class="VKM.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Önizleme" Height="700" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrBg}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="NameText" Grid.Row="0" Foreground="{DynamicResource BrText}" FontSize="14" FontWeight="SemiBold"
                   Margin="16,14,16,8" TextTrimming="CharacterEllipsis"/>

        <Grid Grid.Row="1" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Banner" Grid.Column="0" CornerRadius="7" Padding="12,8">
                <TextBlock x:Name="BannerText" FontSize="13" FontWeight="SemiBold"/>
            </Border>
            <Button x:Name="StopButton" Grid.Column="1" Content="■ Durdur" Click="Stop_Click"
                    Margin="10,0,0,0" Padding="14,0" Height="34" VerticalAlignment="Center"
                    Background="{DynamicResource BrBadBg}" Foreground="{DynamicResource BrBad}" BorderThickness="0" Cursor="Hand"
                    Visibility="Collapsed"/>
        </Grid>

        <TabControl Grid.Row="2" Margin="16,0,16,16" Background="Transparent" BorderBrush="{DynamicResource BrLine}">
            <!-- Görselleştirme -->
            <TabItem Header="Görselleştirme">
                <Border Background="{DynamicResource BrConsoleBg}">
                    <Grid>
                        <Image x:Name="Img" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                        <TextBox x:Name="TextView" IsReadOnly="True" Visibility="Collapsed"
                                 Background="{DynamicResource BrConsoleBg}" Foreground="{DynamicResource BrConsoleTx}" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12.5" Margin="8"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                        <TextBlock x:Name="InfoText" Foreground="{DynamicResource BrDim}" FontSize="12.5" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Dosya verisinin Hex'i (diskin değil) -->
            <TabItem Header="Hex (dosya verisi)">
                <TextBox x:Name="HexBox" IsReadOnly="True"
                         Background="{DynamicResource BrConsoleBg}" Foreground="{DynamicResource BrConsoleTx}" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Padding="8"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
