<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VeriKurtarmaMerkezi</AssemblyName>
    <RootNamespace>VKM.App</RootNamespace>
    <!-- VLC motoru (LibVLC) native dosyaları x64 — işlem x64 olsun ki bulsun -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Çift tıklayınca otomatik yönetici (UAC) iste -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- MSSQL .mdf → .bak modülü (LocalDB'ye bağlanmak için) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="LTRData.DiscUtils" Version="1.0.90" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- Gömülü VLC motorlu CCTV oynatıcı (her codec, sistem codec'i gerekmez) -->
    <PackageReference Include="LibVLCSharp" Version="3.8.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
  </ItemGroup>

</Project>
